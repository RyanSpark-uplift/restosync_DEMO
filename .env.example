# RestoSync — environment template. Copy to `.env` at repo root: cp .env.example .env
# Apps load it via `node --env-file=../../.env` (see apps/api/package.json).

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Matches docker-compose.yml (rs_user / rs_pass / restosync on :5432)
DATABASE_URL=postgres://rs_user:rs_pass@localhost:5432/restosync
REDIS_URL=redis://localhost:6379

# ── Auth / security ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-dev-only-use-a-long-random-string
QR_HMAC_SECRET=change-me-dev-only-hmac-secret
# Comma-separated allowed origins (CORS)
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ── Object storage (Cloudflare R2 / S3-compatible) — needed for uploads ───────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
S3_BUCKET=
AWS_REGION=auto
CDN_BASE_URL=

# ── Optional integrations ─────────────────────────────────────────────────────
REMOVEBG_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Client (Expo) ─────────────────────────────────────────────────────────────
# Tablet/TV read this at build time. Use your Mac LAN IP for physical devices.
EXPO_PUBLIC_API_URL=http://localhost:3000
