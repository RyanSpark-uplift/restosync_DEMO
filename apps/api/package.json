{
  "name": "@restosync/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=../../.env dist/server.js",
    "worker": "tsx watch --env-file=../../.env src/workers/index.ts",
    "worker:start": "node --env-file=../../.env dist/workers/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^3.1.0",
    "@fastify/websocket": "^10.0.1",
    "@restosync/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.12",
    "drizzle-orm": "^0.31.4",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.5",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.22.8",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
