{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@restosync/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@restosync/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@restosync/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@restosync/shared/*": [
        "../../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
