apps/*/android/local.properties
apps/*/ios/Pods/
apps/*/ios/build/

# Uploads (runtime user content)
uploads/*
apps/api/uploads/*
!uploads/.gitkeep
!apps/api/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local dev launcher logs/screenshots
.dev-logs/

# OS
.DS_Store
Thumbs.db

