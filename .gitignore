# Dependencies
node_modules/
.pnpm-store/

# Env / secrets
.env
.env.*
!.env.example

# Build outputs
dist/
build/
*.tsbuildinfo

# Expo / RN
.expo/
web-build/
apps/*/dist/
apps/*/.expo/
apps/*/.expo-*-check/
apps/tablet/web-build/

